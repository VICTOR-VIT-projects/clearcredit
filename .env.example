# Copy to .env and fill in. Never commit .env.
# Base Sepolia RPC (public endpoint works for low volume)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Deployer / verifier key (testnet only, fund via a Base Sepolia faucet)
DEPLOYER_PRIVATE_KEY=
# Set after deploy
REGISTRY_ADDRESS=
# Optional: BaseScan API key for contract verification
BASESCAN_API_KEY=
