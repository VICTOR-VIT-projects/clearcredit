# Optional configuration reference. Never commit a populated environment file.
# README uses process variables and CLEARCREDIT_NO_ENV=1, disabling file reads.
# Local-only settings; use a fresh v2 local address and a separate disposable DB:
CHAIN_RPC_URL=http://127.0.0.1:8545
CLEARCREDIT_DB=clearcredit-local.sqlite3
CLEARCREDIT_OFFLINE_EVIDENCE=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8000
VITE_CHAIN_ID=31337
ADMIN_TOKEN=
# Base Sepolia RPC (public endpoint works for low volume)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Deployer / verifier key (testnet only, fund via a Base Sepolia faucet)
DEPLOYER_PRIVATE_KEY=
# Set after deploy
REGISTRY_ADDRESS=
# Optional: BaseScan API key for contract verification
BASESCAN_API_KEY=
